# --- Discord (Developer Portal: https://discord.com/developers/applications) ---
# Bot tab -> Reset Token. Treat like a password; never commit the real .env.
DISCORD_TOKEN=
# General Information tab -> Application ID.
DISCORD_APPLICATION_ID=
# Right-click your server -> Copy Server ID (enable Developer Mode in Discord settings).
DISCORD_GUILD_ID=
# Channel where backup / restart / server notifications are posted.
NOTIFY_CHANNEL_ID=
# Optional separate channel for the chatty live join/leave feed, so members can
# mute it independently of NOTIFY_CHANNEL_ID. Leave blank to disable the feed.
ACTIVITY_CHANNEL_ID=
# Optional dedicated channel for milestone cards. Defaults to NOTIFY_CHANNEL_ID.
MILESTONES_CHANNEL_ID=
# Role allowed to run admin commands (/backup, /announce). Right-click role -> Copy Role ID.
ADMIN_ROLE_ID=
# Display name for your server, shown in command replies and embeds.
SERVER_LABEL=My Palworld Server

# --- Palhelm panel ---
# Base URL of the Palhelm panel, no trailing slash, e.g. http://palhelm.lan:8080
PALHELM_BASE_URL=
# Integration API bearer key (phk_...). Create one in the panel as admin
# (POST /api/v1/integration-keys) — the plaintext is shown exactly once.
PALHELM_INTEGRATION_KEY=
# Panel admin password. Needed for the parts the read-only Integration API
# does not cover: triggering backups, the live event stream (notifications),
# and fetching map tiles / pal icon images.
PALHELM_ADMIN_PASSWORD=

# --- Behavior (optional) ---
# Comma-separated event kinds to announce in NOTIFY_CHANNEL_ID.
# Available: backup,system,join,leave,panel,config
NOTIFY_EVENT_KINDS=backup,system
# Set true to temporarily mute "world save format drift" notices (e.g. while the
# panel's parser is catching up to a new Palworld version). Default: false.
NOTIFY_SUPPRESS_DRIFT=false

# Persistent bot-side observation history. Relative paths resolve from bot/.
BOT_DATA_DIR=data
# Advanced recovery mode: permit history tracking while the panel reports save
# format drift, but only after two consecutive structurally consistent snapshots.
# The confirmation candidate is in memory, so a bot restart requires two fresh
# consistent snapshots again. Keep false unless an operator has inspected the data.
HISTORY_ALLOW_FORMAT_DRIFT=false
# Post conservative, snapshot-inferred milestones after a silent first baseline.
MILESTONES_ENABLED=true
# Weekly digest is opt-in. Day uses local server time: 0=Sunday ... 6=Saturday.
WEEKLY_DIGEST_ENABLED=false
WEEKLY_DIGEST_WEEKDAY=0
WEEKLY_DIGEST_HOUR=18
# Opt-in sustained low-FPS and stale-save/recovery notifications. Never restarts anything.
HEALTH_ALERTS_ENABLED=false

# --- Optional read-only AI assistant (/ask) ---
# Create a capped key in OpenRouter. The bot never exposes admin/session tools.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Per-provider-call deadline. Tool-using answers can make multiple calls.
AI_TIMEOUT_MS=60000
AI_DAILY_REQUEST_LIMIT=100
AI_COOLDOWN_SEC=30
# Optional: self-hosted SearXNG instance for Palworld-scoped web lookups in /ask.
# The instance must enable the JSON format (search.formats: [html, json] in
# settings.yml). Leave blank to have /ask answer only from server + pinned data.
SEARXNG_URL=
# Bound slow searches and reuse successful queries to reduce latency and load.
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_CACHE_TTL_SEC=21600
