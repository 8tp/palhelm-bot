{
  "name": "palhelm-bot",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/8tp/palhelm-bot.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "register": "tsx src/discord/register.ts",
    "smoke:registry": "node --import tsx test/smoke-registry.ts",
    "smoke:public-api": "node --import tsx scripts/smoke-public-api.ts",
    "knowledge:ingest": "tsx scripts/ingest-mediawiki.ts",
    "knowledge:locations": "tsx scripts/import-wiki-locations.ts",
    "knowledge:evaluate": "tsx scripts/evaluate-knowledge.ts",
    "models:compare": "tsx scripts/compare-models.ts",
    "models:compare-live": "tsx scripts/compare-models-live.ts",
    "icons:audit": "node --import tsx scripts/audit-pal-icons.ts",
    "icons:extras": "node --import tsx scripts/import-extra-icons.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
